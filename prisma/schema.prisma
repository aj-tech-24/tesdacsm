// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  // When targeting the Turso libsql endpoint, set the connection string in
  // the TURSO_DATABASE_URL environment variable. For local development the
  // DATABASE_URL (file:./dev.db) will be used. You can override the target
  // at runtime when running Prisma commands by setting DATABASE_URL or using
  // the --url flag.
  url      = env("TURSO_DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  office    String   // "PO" | "CCNTS" | "PTC"
  role      String   @default("office_admin") // "super_admin" | "office_admin"
  createdAt DateTime @default(now())
}

model Feedback {
  id                     Int      @id @default(autoincrement())
  createdAt              DateTime @default(now())
  controlNumber          String
  name                   String?
  clientType             String?
  age                    String?
  sex                    String?
  formDate               String?
  email                  String?
  employeeName           String?
  regionOfResidence      String?
  province               String?
  municipality           String?
  office                 String?
  citizensCharterService String?
  serviceCategory        String?
  transactionTypes       String?  // comma-separated
  
  cc1                    String?
  cc2                    String?
  cc3                    String?
  
  sqd0                   String?
  sqd1                   String?
  sqd2                   String?
  sqd3                   String?
  sqd4                   String?
  sqd5                   String?
  sqd6                   String?
  sqd7                   String?
  sqd8                   String?
  
  suggestions            String?
  actionProvided         String?
  dateResolved           String?
  natureOfTransaction    String?
  isArchived             Boolean  @default(false)

  notification           Notification?
}

model Notification {
  id                Int      @id @default(autoincrement())
  createdAt         DateTime @default(now())
  readAt            DateTime?
  level             String   @default("warning")
  title             String
  message           String
  controlNumber     String
  office            String?
  service           String?
  lowestRating      Int?
  feedbackId        Int      @unique
  feedback          Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
}

model Analysis {
  id        Int      @id @default(autoincrement())
  content   String
  updatedAt DateTime @updatedAt
}

model ReportMetadata {
  id                  Int      @id @default(autoincrement())
  reportPeriod        String   @default("")
  regionExecutive     String?
  provinceDistrict    String?
  operatingUnit       String?
  headOfUnit          String?
  designation         String?
  cusatFocal          String?
  updatedAt           DateTime @updatedAt
}

model Achievement {
  id           Int      @id @default(autoincrement())
  title        String
  description  String
  imagePath    String?
  iconName     String?
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
